# ==========================================================================
# .env.example — copiare in .env (non committare il .env reale)
# ==========================================================================
# Tutti i valori qui sono PLACEHOLDER. Sostituisci con i tuoi reali in .env.
# Variabili usate da script locali / curl di test / future integrazioni MCP.
# ==========================================================================

# --- n8n self-hosted ---
N8N_URL=https://n8n.tuodominio.it
N8N_API_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx
N8N_WEBHOOK_BASE=https://n8n.tuodominio.it/webhook

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_USERNAME=tua_agency_bot
# Whitelist chat ID admin (te) separati da virgola
TELEGRAM_ADMIN_CHAT_IDS=123456789

# --- Trello ---
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_BOARD_ID=RerUVz3u

# --- AI providers ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- CRM / Database ---
# Scegli uno (Airtable, Baserow, NocoDB, HubSpot...)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# --- Email outbound ---
# Brevo / Resend / SMTP custom
BREVO_API_KEY=
RESEND_API_KEY=

# --- Lead sourcing ---
APOLLO_API_KEY=
LINKEDIN_SALES_NAV_COOKIE=

# --- Google Workspace (per calendario, drive, sheets) ---
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./credentials/google-service-account.json

# --- PEC / SDI Italia (opzionale, per commercialisti/avvocati) ---
PEC_HOST=
PEC_USER=
PEC_PASS=
SDI_PROVIDER=
SDI_API_KEY=
